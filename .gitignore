# Logs
*.log

# OS generated files
.DS_Store

# Node modules and build artifacts
node_modules/

# Compiled source
*.com
*.class
*.dll
*.exe
*.o
*.so

# Laravel Mix files
npm-debug.log
yarn-error.log
yarn.lock
package-lock.json
mix-manifest.json

# Production files (already included in dist/)
*.map

# Backup & deployment files
*.bak
*.swp
*.tmp
*.temp
*.orig

# IDE files
.idea/
*.sublime-project
*.sublime-workspace
.vscode/
*.code-workspace

# Sensitive files (update this list based on your actual use case)
.env
.env.*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Cache directories
.cache/
.npm/
.eslintcache

# vendor/ is committed (prod-only) so plugin updates apply without
# `composer install`. Allowlist approach: everything in vendor is ignored
# except the autoloader, composer's own files, and each explicitly-named
# UNPREFIXED production package. Strauss-prefixed deps live in vendor-prefixed/.
/vendor/*
!/vendor/autoload.php
!/vendor/composer/
!/vendor/intervention/
!/vendor/yahnis-elsts/
# Auto-regenerates with the current git ref, so tracking it dirties
# the tree after every commit.
/vendor/composer/installed.php
# Strauss (dev-only) pulls composer/composer + its deps, which physically
# nest under vendor/composer/. They're dev tooling, absent from a --no-dev
# install, and must not ship — re-ignore them under the composer/ allowlist.
/vendor/composer/ca-bundle/
/vendor/composer/class-map-generator/
/vendor/composer/composer/
/vendor/composer/metadata-minifier/
/vendor/composer/pcre/
/vendor/composer/semver/
/vendor/composer/spdx-licenses/
/vendor/composer/xdebug-handler/

# Strauss-prefixed runtime dependencies (committed; ship without a build step).
!/vendor-prefixed/

# Strauss binary self-downloads via the composer scripts.
bin/strauss.phar
.githooks/
